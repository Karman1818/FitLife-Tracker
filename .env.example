# Database Connection URL (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/fitlife_db?schema=public"

# NextAuth Configuration (generate with: npx auth secret or openssl rand -base64 32)
AUTH_SECRET="your-super-secret-key-at-least-32-chars-long"

# Resend Email Provider (Magic Link Authentication)
EMAIL_FROM="noreply@yourdomain.com"
AUTH_RESEND_KEY="re_123456789"
